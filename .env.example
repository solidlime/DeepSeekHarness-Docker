# ブラウザからアクセスする authority。Host と完全一致させる。
# 複数の authority を許可したい場合はカンマ区切りにせず、
# entrypoint の dsh コマンドに --trusted-host を増やして対応する。
# 既定は nas:3080（docker-compose.yml / docker-entrypoint.sh 側の既定と同一）。
DSH_TRUSTED_HOST=nas:3080

# dsh が喋る LiteLLM ゲートウェイ。dsh は 127.0.0.1 にしか bind しないので、
# これは「コンテナ → ホスト」の向き。192.168.176.1 は NAS の docker bridge
# gateway（= ホスト自身）。ホスト IP が違う環境ではその IP に変える。
# モデル名（Orchestrator / General など）は dsh/cordis.patch.yml 側で定義している。
DSH_LITELLM_URL=http://192.168.176.1:4000/v1

# LiteLLM の MASTER KEY。entrypoint が .credentials.yaml の refs: に
# DSH_LITELLM_KEY として登録し、llm-pi-ai の apiKeyEnv がそれを引く。
# 空のままだとモデルを選んだときに MISSING_CREDENTIAL になる（起動はする）。
DSH_LITELLM_KEY=